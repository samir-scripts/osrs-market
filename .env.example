# PostgreSQL configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=osrs_market
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Hasura configuration
HASURA_GRAPHQL_ADMIN_SECRET=hasura_secure_admin_secret
HASURA_GRAPHQL_DATABASE_URL=postgres://postgres:postgres_secure_pass@osrs-postgres:5432/osrs_market
HASURA_GRAPHQL_DEV_MODE=true

# MinIO configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_pass
MINIO_DEFAULT_BUCKETS=osrs-parquet

# Redpanda / Kafka configuration
REDPANDA_HOST=redpanda
REDPANDA_PORT=9092
SCHEMA_REGISTRY_HOST=redpanda
SCHEMA_REGISTRY_PORT=8081

# Airflow configuration
AIRFLOW_IMAGE_NAME=apache/airflow:2.9.2
AIRFLOW_UID=50000
_PIP_ADDITIONAL_REQUIREMENTS=confluent-kafka requests psycopg2-binary duckdb minio fastavro pyarrow
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres_secure_pass@osrs-postgres:5432/osrs_market?options=-csearch_path=airflow

# Producer and Analytics service configs
PRODUCER_API_KEY=local_producer_key
ANALYTICS_API_KEY=local_analytics_key

# Redis configuration
REDIS_URL=redis://redis:6379

# Rust processor & DAG configuration  
WORKER_COUNT=0
BATCH_SIZE=500
MAX_UPLOAD_CONCURRENCY=8
PRIORITY_PRICE_THRESHOLD=1000000
PRIORITY_VOLUME_THRESHOLD=10000
